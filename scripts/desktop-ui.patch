+[[nodiscard]] std::string ReadConfig() {
+  const auto raw = QByteArray::fromStdString(ReadExplicitConfig());
+  auto error = QJsonParseError();
+  const auto document = QJsonDocument::fromJson(raw, &error);
+  if (!raw.isEmpty() &&
+      (error.error != QJsonParseError::NoError || !document.isObject())) {
+    LOG(("Chatcraft: invalid engine configuration."));
+    return raw.toStdString();
+  }
+  auto config = document.object();
+  if (!config.contains(QStringLiteral("script_dir"))) {
+    const auto directory = DefaultScriptsDirectory();
+    if (!QDir().mkpath(directory)) {
+      LOG(("Chatcraft: cannot create script directory: %1").arg(directory));
+    }
+    config.insert(QStringLiteral("script_dir"), directory);
+  }
+  const auto directory = config.value(u"script_dir"_q);
+  g_scriptsDirectoryEnabled = !directory.isNull();
+  g_scriptsDirectory =
+      directory.isString()
+          ? QDir::current().absoluteFilePath(directory.toString())
+          : DefaultScriptsDirectory();
+  return QJsonDocument(config).toJson(QJsonDocument::Compact).toStdString();
+}
