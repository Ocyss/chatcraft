+void ShowLifecycleNotifications(const QString &event) {
+  const auto notifications = Lifecycle(event);
+  auto sections = QStringList();
+#ifdef CHATCRAFT_ENABLED
+  if (event == u"startup"_q) {
+    auto settings = QSettings(QSettings::IniFormat, QSettings::UserScope,
+                              u"Chatcraft"_q, u"Desktop"_q);
+    const auto key = u"chatcraft/scripts/introductionShown"_q;
+    if (!settings.value(key, false).toBool()) {
+      sections.push_back(
+          u"欢迎使用 Chatcraft Lua 脚本\n"
+          "在主菜单的「Lua 脚本管理」中查看脚本信息和加载状态。\n"
+          "仅安装可信脚本；添加或修改后需重启应用。\n"
+          "更新地址仅供查看，不会自动下载或安装。"_q);
+      settings.setValue(key, true);
+    }
+  }
+#endif
+  for (const auto &value : notifications) {
+    const auto notification = value.toObject();
+    const auto title = notification.value(u"title"_q).toString();
+    const auto text = notification.value(u"text"_q).toString();
+    const auto path = notification.value(u"path"_q).toString();
+    if (!title.isEmpty() || !text.isEmpty()) {
+      sections.push_back(title + u"\n"_q + text +
+                         (path.isEmpty() ? QString() : u"\n脚本："_q + path));
+    }
+  }
+  if (sections.isEmpty()) {
+    return;
+  }
+  const auto box =
+      new QMessageBox(QMessageBox::Information, u"Chatcraft · 脚本通知"_q,
+                      QString(), QMessageBox::Ok);
+  box->setAttribute(Qt::WA_DeleteOnClose);
+  box->setAttribute(Qt::WA_QuitOnClose, false);
+  box->setTextFormat(Qt::PlainText);
+  box->setText(sections.join(u"\n\n────────────\n\n"_q));
+  box->setWindowModality(Qt::NonModal);
+  box->show();
+}
+
 } // namespace Chatcraft
