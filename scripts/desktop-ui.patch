+    return SubItemValue(rowPtr, _filterId, active[column]);
+  } else if (_state == WidgetState::Filtered) {
+    const auto ref = filteredChildAt(row);
+    if (!ref || ref->cohort != AccessibilityCohort::Filtered) {
+      return {};
