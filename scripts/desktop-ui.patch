+        box, rpl::single(u"脚本目录："_q + Chatcraft::ScriptsDirectory()),
+        st::boxLabel));
+    if (!Chatcraft::ScriptsDirectoryEnabled()) {
+      box->addRow(object_ptr<Ui::FlatLabel>(
+          box, rpl::single(u"目录自动加载已禁用（script_dir: null）。"_q),
+          st::boxLabel));
+    }
+    if (scripts.isEmpty()) {
+      box->addRow(object_ptr<Ui::FlatLabel>(
+          box, rpl::single(u"暂无 Lua 脚本"_q), st::boxLabel));
+    }
+    for (const auto &value : scripts) {
+      const auto script = value.toObject();
+      const auto error = script.value(u"error"_q).toString();
+      const auto loaded = script.value(u"loaded"_q).toBool();
+      const auto metadata = script.value(u"metadata"_q).toObject();
+      const auto name = metadata.value(u"name"_q).toString().trimmed();
+      const auto version = metadata.value(u"version"_q).toString().trimmed();
+      const auto title =
+          (name.isEmpty() ? script.value(u"name"_q).toString(u"未命名脚本"_q)
+                          : name) +
+          (version.isEmpty() ? QString() : u"  ·  v"_q + version);
+      box->addRow(
+          object_ptr<Ui::FlatLabel>(box, rpl::single(title), st::boxLabel));
+      box->addRow(object_ptr<Ui::FlatLabel>(
+          box, rpl::single(loaded ? u"● 已加载"_q : u"○ 未加载 / 错误"_q),
+          st::boxLabel));
+      const auto description = metadata.value(u"description"_q).toString();
+      if (!description.isEmpty()) {
+        box->addRow(object_ptr<Ui::FlatLabel>(box, rpl::single(description),
+                                              st::boxLabel));
+      }
+      auto details = QStringList();
+      const auto author = metadata.value(u"author"_q).toString();
+      const auto updateUrl = metadata.value(u"update_url"_q).toString();
+      if (!author.isEmpty()) {
+        details.push_back(u"作者："_q + author);
+      }
+      const auto path = script.value(u"path"_q).toString();
+      if (!path.isEmpty()) {
+        details.push_back(u"文件："_q + path);
+      }
+      if (!updateUrl.isEmpty()) {
+        details.push_back(u"更新地址（仅展示）："_q + updateUrl);
+      }
+      if (!error.isEmpty()) {
+        details.push_back(u"错误："_q + error);
+      }
+      if (!details.isEmpty()) {
+        box->addRow(object_ptr<Ui::FlatLabel>(
+            box, rpl::single(details.join(u"\n"_q)), st::boxLabel));
+      }
+      box->addRow(object_ptr<Ui::FlatLabel>(
+          box, rpl::single(u"────────────────────────"_q), st::boxLabel));
+    }
+    box->addRow(object_ptr<Ui::FlatLabel>(
+        box,
+        rpl::single(u"添加、修改或删除脚本后，请重启应用以重新加载。\n"
+                    "更新地址仅展示，不会自动下载或安装脚本。"_q),
+        st::boxLabel));
+    box->addButton(rpl::single(u"打开脚本文件夹"_q), [=] {
