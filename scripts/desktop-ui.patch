+QString DefaultScriptsDirectory() {
+  const auto override = QString::fromUtf8(qgetenv("CHATCRAFT_SCRIPT_DIR"));
+  if (!override.isEmpty()) {
+    return QDir::current().absoluteFilePath(override);
+  }
+  const auto base = QDir(QCoreApplication::applicationDirPath());
+  const auto scripts = base.absoluteFilePath(u"scripts"_q);
+  const auto legacy = base.absoluteFilePath(u"script"_q);
+  return !base.exists(u"scripts"_q) && QDir(legacy).exists() ? legacy : scripts;
+}
 
