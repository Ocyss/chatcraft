+std::deque<QJsonObject> g_uiRequests;
+
+void ScheduleUiRequests();
+
+void DrainUiRequests() {
+  if (!g_engine || QCoreApplication::closingDown() || g_uiRequestBox) {
+    return;
+  }
+  if (g_uiRequests.empty()) {
+    const auto raw = chatcraft_ui_requests(g_engine);
+    if (!raw) {
+      return;
+    }
+    const auto guard = gsl::finally([&] { chatcraft_string_free(raw); });
+    const auto document = QJsonDocument::fromJson(QByteArray(raw));
+    if (!document.isArray()) {
+      LOG(("Chatcraft: invalid UI request queue response."));
+      return;
+    }
+    for (const auto &value : document.array()) {
+      const auto request = value.toObject();
+      const auto id = request.value(u"id"_q);
+      const auto number = id.toDouble(-1.);
+      const auto kind = request.value(u"kind"_q).toString();
+      if (!id.isDouble() || !std::isfinite(number) || number <= 0. ||
+          number > 9007199254740991. || std::floor(number) != number ||
+          (kind != u"alert"_q && kind != u"confirm"_q) ||
+          !request.value(u"title"_q).isString() ||
+          !request.value(u"text"_q).isString()) {
+        LOG(("Chatcraft: invalid UI request."));
+        continue;
+      }
+      g_uiRequests.push_back(request);
+    }
+  }
+  if (g_uiRequests.empty()) {
+    return;
+  }
+  const auto request = g_uiRequests.front();
+  g_uiRequests.pop_front();
+  const auto confirm = request.value(u"kind"_q).toString() == u"confirm"_q;
+  const auto box = new QMessageBox(
+      confirm ? QMessageBox::Question : QMessageBox::Information,
+      request.value(u"title"_q).toString(), request.value(u"text"_q).toString(),
+      confirm ? (QMessageBox::Yes | QMessageBox::No) : QMessageBox::Ok);
+  g_uiRequestBox = box;
+  box->setAttribute(Qt::WA_DeleteOnClose);
+  box->setAttribute(Qt::WA_QuitOnClose, false);
+  box->setTextFormat(Qt::PlainText);
+  box->setWindowModality(Qt::NonModal);
+  if (confirm) {
+    box->setDefaultButton(QMessageBox::No);
+    box->setEscapeButton(QMessageBox::No);
+  }
+  const auto app = QCoreApplication::instance();
+  QObject::connect(app, &QCoreApplication::aboutToQuit, box,
+                   &QObject::deleteLater);
+  QObject::connect(
+      box, &QMessageBox::finished, app,
+      [id = request.value(u"id"_q), confirm](int result) {
+        g_uiRequestBox = nullptr;
+        if (!g_engine || QCoreApplication::closingDown()) {
+          return;
+        }
+        if (confirm) {
+          const auto json =
+              QJsonDocument(
+                  QJsonObject{{u"id"_q, id},
+                              {u"confirmed"_q, result == QMessageBox::Yes}})
+                  .toJson(QJsonDocument::Compact);
+          const auto raw = chatcraft_ui_respond(g_engine, json.constData());
+          if (raw) {
+            chatcraft_string_free(raw);
+          }
+        }
+        ScheduleUiRequests();
+      });
+  box->show();
+}
+
+void ScheduleUiRequests() {
+  const auto app = QCoreApplication::instance();
+  if (!app || QCoreApplication::closingDown() || !g_engine ||
+      g_uiRequestsScheduled || g_uiRequestBox) {
+    return;
+  }
+  Expects(QThread::currentThread() == app->thread());
+  g_uiRequestsScheduled = true;
+  QTimer::singleShot(0, app, [] {
+    g_uiRequestsScheduled = false;
+    DrainUiRequests();
+  });
+}
