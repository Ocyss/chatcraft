+RowDescriptor InnerWidget::computeJump(const RowDescriptor &to,
+                                       JumpSkip skip) const {
+  auto result = to;
+  if (result.key) {
+    const auto down =
+        (skip == JumpSkip::NextOrEnd) || (skip == JumpSkip::NextOrOriginal);
+    const auto needSkip = [&] {
+      return (result.key.folder() != nullptr) ||
+             (session().supportMode() &&
+              !result.key.entry()->chatListBadgesState().unread);
+    };
+    while (needSkip()) {
+      const auto next =
+          down ? chatListEntryAfter(result) : chatListEntryBefore(result);
+      if (next.key) {
+        result = next;
+      } else {
+        if (skip == JumpSkip::PreviousOrOriginal ||
+            skip == JumpSkip::NextOrOriginal) {
+          result = to;
+        }
+        break;
+      }
+    }
+  }
+  return result;
 }
 
