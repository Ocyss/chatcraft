+      : _openedForum     ? _openedForum->topicsList()->indexed()
+      : _openedCommunity ? _openedCommunity->chatsList()->indexed()
+      : _filterId
+          ? session().data().chatsFilters().chatsList(_filterId)->indexed()
+          : session().data().chatsList(_openedFolder)->indexed();
+  auto keys = std::vector<Key>();
+  auto nativeKeys = std::vector<Key>();
+  if (!_savedSublists && !_openedForum && !_openedCommunity) {
+    auto decisions = std::vector<std::pair<Key, int>>();
+    for (const auto row : *list) {
+      const auto key = row->key();
+      nativeKeys.push_back(key);
+      const auto history = key.history();
+      if (!history) {
+        decisions.emplace_back(key, 0);
+        continue;
+      }
+      auto folders = QJsonArray();
+      for (const auto &filter : session().data().chatsFilters().list()) {
+        if (filter.id() && filter.contains(history)) {
+          folders.append(int(filter.id()));
+        }
+      }
+      const auto peer = history->peer;
+      const auto channel = peer->asChannel();
+      const auto type =
+          channel ? (channel->isMegagroup() ? u"supergroup"_q : u"channel"_q)
+          : peer->isChat() ? u"group"_q
+                           : u"private"_q;
+      const auto decision = Chatcraft::FilterChat(QJsonObject{
+          {u"chat_id"_q, qint64(peer->id.value)},
+          {u"chat_type"_q, type},
+          {u"title"_q, peer->name()},
+          {u"folder_ids"_q, folders},
+          {u"folder_count"_q, int(folders.size())},
+          {u"folder_id"_q,
