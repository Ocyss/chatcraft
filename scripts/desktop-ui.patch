+      const auto paintSection = [&](int sectionTop,
+                                    const CommunityRowsView &view,
+                                    const QString &text, int flatBase) {
+        if (view.empty()) {
+          return;
+        }
+        p.save();
+        p.translate(0, sectionTop);
+        paintBar(text);
