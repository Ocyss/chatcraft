+      ranges::find(_filterResults, Key(history), &FilterResult::key) !=
+      end(_filterResults);
+  if (inFilteredResults) {
+    return true;
+  }
+  const auto inPeerSearchResults =
+      ranges::find(_peerSearchResults, history->peer, [](const auto &result) {
+        return result->peer;
+      }) != end(_peerSearchResults);
+  if (inPeerSearchResults) {
+    return true;
+  }
