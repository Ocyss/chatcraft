+      p.translate(0, from * st::mentionHeight);
+      if (from < _hashtagResults.size()) {
+        const auto htagleft = st::defaultDialogRow.padding.left();
+        auto htagwidth =
+            fullWidth - htagleft - st::defaultDialogRow.padding.right();
