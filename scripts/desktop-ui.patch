+          {u"unread"_q, history->unreadCount() > 0 || history->unreadMark()},
+          {u"unread_count"_q, history->unreadCount()},
+          {u"muted"_q, history->muted()},
+          {u"pinned"_q, history->isPinnedDialog(_filterId)},
+      });
+      if (!decision.hide) {
+        decisions.emplace_back(key, decision.priority);
+      }
+    }
+    std::stable_sort(decisions.begin(), decisions.end(),
+                     [](const auto &a, const auto &b) {
+                       if (!a.first.history() || !b.first.history()) {
+                         return bool(b.first.history()) && !a.first.history();
+                       }
+                       return a.second > b.second;
+                     });
+    for (const auto &decision : decisions) {
+      keys.push_back(decision.first);
+    }
+  }
+  if (keys != nativeKeys) {
+    if (!_chatcraftProjection || keys != _chatcraftKeys ||
+        _chatcraftProjectionFilterId != _filterId) {
+      clearSelection();
+      clearPressed();
+      _qdragging = nullptr;
