@@ -0,0 +1,32 @@
+// Chatcraft: Telegram Desktop 消息过滤 FFI 桥接层。
+// 由 patches/desktop 维护，rebase 上游时请保留本目录。
+#pragma once
+
+namespace HistoryView { class Element; }
+class HistoryItem;
+class History;
+
+namespace Chatcraft {
+
+enum class FilterAction {
+	Allow,
+	Hide,
+	Collapse,
+	Highlight,
+};
+
+// 惰性初始化，首次过滤时自动调用；也可在启动时显式调用。
+// 配置来源：
+//   CHATCRAFT_CONFIG      EngineConfig JSON 字符串
+//   CHATCRAFT_CONFIG_FILE EngineConfig JSON 文件路径
+//   CHATCRAFT_LUA_SCRIPT  Lua 脚本路径（等价于 config.lua_script）
+//   CHATCRAFT_DISABLE_ADS / CHATCRAFT_ENABLE_ADS 广告开关（Rust 侧读取）
+void EnsureInitialized();
+
+// 对一条消息求值。FFI 不可用或出错时返回 Allow（安全降级）。
+FilterAction FilterMessage(not_null<const HistoryItem*> item);
+
+// 官方广告是否被禁用（环境变量 / 运行时覆盖）。
+bool AdsDisabled();
+
+} // namespace Chatcraft
